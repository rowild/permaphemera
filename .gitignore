# Local design source and backup material (large binaries)
_BU/
_Material/

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.af~lock~
.idea
.fleet
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code local settings (skills and critiques stay tracked)
.claude/settings.local.json
.claude/.mcp.json

# Directus runtime data and secrets (see directus/.gitignore too)
directus/.env
directus/database/*
!directus/database/.gitkeep
directus/uploads/*
!directus/uploads/.gitkeep

# Frontend build and dependency output (frontend/.gitignore covers the rest)
frontend/node_modules
frontend/.nuxt
frontend/.output
frontend/dist

# Affinity design source files (binary, large)
*.af

# Subagent-driven-development scratch workspace
.superpowers/
directus/.env.remote

# Working material, backups and design sources never belong in git
_Material/
*.af
.serena/
# Plan images: the uploaded copies are in Directus
plans/*/images/
# Plan source pages: downloaded web pages and PDFs, third-party content
plans/*/pages/
plans/*/venv/
__pycache__/
plans/*/screenshots/
plans/*/logs/
plans/*/research/
plans/*/*.jpg
plans/*/*.png
.impeccable/hook.cache.json# Plan working files (owner, 2026-11-11): screenshots, logs, research copies, third-party
# images (the uploaded copies are in Directus), Python environments and caches.
plans/*/screenshots/
plans/*/logs/
plans/*/research/
plans/*/*.jpg
plans/*/*.png
plans/*/venv/
__pycache__/
# Brand logo: the -v2 files are copies of the tracked permaphemera-logo-*.svg; scripts were checks
plans/2026-11-11__brand-logo-svg/permaphemera-logo-v2-*.svg
plans/2026-11-11__brand-logo-svg/scripts/
# Design-check cache (the rules in .impeccable/config.json stay tracked)
.impeccable/hook.cache.json
