{
  "name": "frontend",
  "version": "0.0.68",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.11.1 <25",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "nuxt generate",
    "check:conventions": "node scripts/check-conventions.mjs",
    "check:data": "node scripts/check-data-integrity.mjs",
    "check:preloader": "node scripts/check-kaleidoscope-preloader.mjs",
    "check:public": "node scripts/check-public-namespace.mjs",
    "check:tailwind": "node scripts/check-tailwind-canonical.mjs",
    "check:types": "nuxt typecheck",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry-run": "node scripts/deploy.mjs --dry-run",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "serve --single .output/public",
    "postinstall": "nuxt prepare",
    "qa:safari": "bash qa/safari/run-all.sh",
    "qa:safari:audit": "node qa/safari/audit/fetch.mjs && node qa/safari/audit/css.mjs && node qa/safari/audit/js.mjs",
    "qa:safari:mac": "node qa/safari/drivers/safari.mjs",
    "qa:safari:report": "node qa/safari/report.mjs",
    "qa:safari:serve": "node qa/safari/server.mjs",
    "qa:safari:sim": "node qa/safari/drivers/simulator.mjs",
    "qa:safari:webkit": "node qa/safari/drivers/webkit.mjs",
    "news:report": "node scripts/news-report.mjs",
    "test": "vitest run",
    "tour:publish": "node scripts/publish-tour.mjs",
    "tour:start-view": "node scripts/tour-start-view.mjs",
    "tour:status": "node scripts/tour-status.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "verify": "vitest run && pnpm -s lint && pnpm -s check:tailwind && pnpm -s check:conventions && pnpm -s check:preloader && pnpm -s check:types",
    "verify:live": "pnpm -s check:data && pnpm -s check:public",
    "deploy:hetzner": "bash scripts/deploy-hetzner.sh",
    "cache:purge": "node scripts/purge-cloudflare.mjs",
    "seo:snapshot": "node scripts/seo-snapshot.mjs",
    "viewer:update": "node scripts/update-tour-viewer.mjs",
    "prepare": "git -C .. config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@lucide/vue": "^1.23.0",
    "@nuxtjs/i18n": "10.2.4",
    "@tailwindcss/vite": "^4.3.2",
    "@types/three": "^0.185.0",
    "flag-icons": "^7.5.0",
    "gsap": "^3.15.0",
    "nuxt": "^4.4.8",
    "tailwindcss": "^4.3.2",
    "three": "^0.185.1",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@mdn/browser-compat-data": "^8.1.6",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "playwright": "1.63.0",
    "postcss": "^8.5.31",
    "serve": "^14.2.6",
    "sharp": "0.35.5",
    "ssh2-sftp-client": "^12.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
