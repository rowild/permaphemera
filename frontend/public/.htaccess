<IfModule mod_headers.c>
  # public/ filenames are not content hashed by nuxt generate, so this is a
  # deliberate month rather than a year. Rename an image to bust it sooner.
  <FilesMatch "\.(?:avif|gif|ico|jpe?g|png|svg|webp)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve real files unchanged. Directory requests fall through to the SPA
  # router below; the single public/media/ namespace keeps asset directories
  # from ever shadowing an application route.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Let the client-side Nuxt router resolve every clean URL.
  RewriteRule ^ index.html [L]
</IfModule>
