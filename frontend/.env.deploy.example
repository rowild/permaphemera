# Copy this file to .env.deploy.local and fill in the real values.
# .env.deploy.local is git-ignored and must never be committed.

# all-inkl shared hosting, reached over SFTP.
DEPLOY_SSH_HOST=rowild.at
DEPLOY_SSH_PORT=22
DEPLOY_SSH_USER=ssh-w00c8d25

# The OpenSSH PRIVATE key. Not the .pub file, which is the public half and
# belongs on the server, and not a PuTTY .ppk, which this client cannot read.
DEPLOY_SSH_KEY=/Users/robertwildling/.ssh/id_ed25519_rowild_openssh

# Only needed when the private key is passphrase protected. Leave empty
# otherwise.
DEPLOY_SSH_PASSPHRASE=

# Absolute document root of the domain on the server.
DEPLOY_REMOTE_DIR=/www/htdocs/w00c8d25/exhibition-archiv.rowild.at

# Cloudflare, in front of permaphemera.at. `pnpm deploy:hetzner` empties its
# cache after every upload (and `pnpm cache:purge` on its own), so a file
# replaced under the same name — the tour viewer, a re-graded panorama — is
# live at once instead of after up to 4 hours.
# Token: Cloudflare dashboard → My Profile → API Tokens → Create Token →
# Custom token, permission "Zone · Cache Purge · Purge", zone permaphemera.at.
# Zone ID: the domain's Overview page, right column, under "API".
# Not CLOUDFLARE_API_TOKEN: wrangler and other tools read that name, and a
# shell may export a different token under it, which would win over this file.
CLOUDFLARE_PURGE_TOKEN=
CLOUDFLARE_ZONE_ID=
