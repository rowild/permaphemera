# Copy this file to .env.deploy.local and fill in the real values.
# .env.deploy.local is git-ignored and must never be committed.

# all-inkl shared hosting, reached over SFTP.
DEPLOY_SSH_HOST=rowild.at
DEPLOY_SSH_PORT=22
DEPLOY_SSH_USER=ssh-w00c8d25

# The OpenSSH PRIVATE key. Not the .pub file, which is the public half and
# belongs on the server, and not a PuTTY .ppk, which this client cannot read.
DEPLOY_SSH_KEY=/Users/robertwildling/.ssh/id_ed25519_rowild_openssh

# Only needed when the private key is passphrase protected. Leave empty
# otherwise.
DEPLOY_SSH_PASSPHRASE=

# Absolute document root of the domain on the server.
DEPLOY_REMOTE_DIR=/www/htdocs/w00c8d25/exhibition-archiv.rowild.at
