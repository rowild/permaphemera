{
  "name": "frontend",
  "version": "0.0.18",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.11.1 <25",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "nuxt generate",
    "check:artists": "node scripts/check-artist-directory-modal.mjs",
    "check:data": "node scripts/check-data-integrity.mjs",
    "check:directories": "node scripts/check-directory-routes.mjs",
    "check:i18n": "node scripts/check-i18n-privacy.mjs",
    "check:links": "node scripts/check-archive-text-links.mjs",
    "check:mobile": "node scripts/check-mobile-density.mjs",
    "check:preloader": "node scripts/check-kaleidoscope-preloader.mjs",
    "check:public": "node scripts/check-public-namespace.mjs",
    "check:tailwind": "node scripts/check-tailwind-canonical.mjs",
    "check:types": "nuxt typecheck",
    "check:venues": "node scripts/check-venue-exhibition-browser.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry-run": "node scripts/deploy.mjs --dry-run",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "serve --single .output/public",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "tour:publish": "node scripts/publish-tour.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@lucide/vue": "^1.23.0",
    "@nuxtjs/i18n": "10.2.4",
    "@tailwindcss/vite": "^4.3.2",
    "@types/three": "^0.185.0",
    "flag-icons": "^7.5.0",
    "gsap": "^3.15.0",
    "nuxt": "^4.4.8",
    "tailwindcss": "^4.3.2",
    "three": "^0.185.1",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "serve": "^14.2.6",
    "ssh2-sftp-client": "^12.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
