# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Random strings. Generate with:
#   uuidgen | tr 'A-Z' 'a-z'      -> KEY
#   openssl rand -hex 32          -> SECRET
KEY=replace-with-uuid
SECRET=replace-with-64-hex-chars

# SQLite for local development. The file lives in ./database (git-ignored).
DB_CLIENT=sqlite3
DB_FILENAME=./database/data.db

# First admin user. Created on the first start only.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me

# Public URL as seen from the browser. Host port 8077 maps to container port 8055.
PUBLIC_URL=http://localhost:8077

# Let the Nuxt dev server (port 4991) call the API.
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:4991
CORS_CREDENTIALS=true

# Local file storage.
STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads

WEBSOCKETS_ENABLED=false

# First start on a fresh database: bootstrap reads these and skips the
# "who owns this project" screen. PROJECT_OWNER must be the admin email.
PROJECT_NAME=PERMAPHEMERA
PROJECT_OWNER=admin@example.com
# Do not send the owner registration or usage reports to Directus.
PROJECT_OWNER_ENABLED=false
TELEMETRY=false
# Static token for the admin user, set at bootstrap. Scripts use it instead of
# a password login. Generate with: openssl rand -hex 32
ADMIN_TOKEN=replace-with-64-hex-chars
