# Server-side environment for the PERMAPHEMERA Directus stack on project-backends.
# Copy to directus/.env.remote (git-ignored), fill in the secrets, then run
# bash directus/hetzner/install-remote.sh. The scripts in directus/scripts/ talk to
# the remote instance with DIRECTUS_ENV_FILE=.env.remote.

HOST=0.0.0.0
PORT=8055
DIRECTUS_PORT=8060
PUBLIC_URL=https://permaphemera.project-backends.info
ACCEPT_TERMS=true
TELEMETRY=false

PROJECT_NAME=PERMAPHEMERA
PROJECT_OWNER=admin@example.com
PROJECT_OWNER_ENABLED=false

# openssl rand -hex 32 for each
KEY=replace
SECRET=replace
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace
ADMIN_TOKEN=replace-with-64-hex-chars
REDIS_PASSWORD=replace

DB_CLIENT=sqlite3
DB_FILENAME=/directus/database/data_permaphemera.db

STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=/directus/uploads
FILES_MAX_UPLOAD_SIZE=200mb

CORS_ENABLED=true
# Local dev server, local preview, and the site domain once it is live.
CORS_ORIGIN=http://localhost:4991,http://localhost:3000,https://permaphemera.at,https://www.permaphemera.at
CORS_METHODS=GET,POST,PATCH,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_EXPOSED_HEADERS=Content-Range
CORS_CREDENTIALS=true
CORS_MAX_AGE=18000

WEBSOCKETS_ENABLED=false
IP_TRUST_PROXY=true

REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_ENABLED=true
CACHE_STORE=redis
CACHE_TTL=5m
CACHE_AUTO_PURGE=true
CACHE_NAMESPACE=permaphemera-cache
RATE_LIMITER_ENABLED=true
RATE_LIMITER_STORE=redis
RATE_LIMITER_POINTS=50
RATE_LIMITER_DURATION=1
SYNCHRONIZATION_STORE=redis
SYNCHRONIZATION_NAMESPACE=directus-sync
